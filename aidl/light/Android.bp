rust_binary {
    name: "android.hardware.lights-service.millennium",
    relative_install_path: "hw",
    init_rc: ["lights-millennium.rc"],
    vintf_fragments: ["lights-millennium.xml"],
    vendor: true,
    rustlibs: [
        "liblogger",
        "liblog_rust",
        "libbinder_rs",
        "android.hardware.light-V2-rust",
    ],
    srcs: [ "main.rs" ],
}
